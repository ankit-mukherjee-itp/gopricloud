# syntax=docker/dockerfile:1

# --- Stage 1: Build the Go application ---
# go.mod declares `go 1.26.4`, so the builder must be >= 1.26 or the toolchain
# refuses to build.
FROM golang:1.26-alpine AS builder

WORKDIR /src

# Dependency manifests first, so `go mod download` stays cached until they change.
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# The module's only `main` package is ./cmd — there is no .go file at the module
# root, so `go build .` here would fail with "no Go files".
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/api ./cmd

# --- Stage 2: Minimal runtime image ---
FROM alpine:3.19

# ca-certificates: needed the moment clouds.yaml points at an https:// endpoint.
# Alpine ships no CA roots, and gophercloud's TLS handshake would fail at first
# use — i.e. only on /instances calls, long after a clean startup.
RUN apk add --no-cache ca-certificates \
 && adduser -D -u 10001 app

# WORKDIR is load-bearing. gophercloud's clientconfig searches the process's
# current working directory for clouds.yaml (then ~/.config/openstack, then
# /etc/openstack) and never walks up the tree. docker-compose.yml mounts
# clouds.yaml to /app/clouds.yaml so this resolves.
WORKDIR /app

COPY --from=builder /out/api /usr/local/bin/api

# Run unprivileged.
USER app

EXPOSE 8080

CMD ["api"]
