# syntax=docker/dockerfile:1

# --- Stage 1: Build the Vite/React/TypeScript bundle ---
FROM node:22-alpine AS builder

WORKDIR /src

# Manifests first so `npm ci` stays cached until dependencies change.
COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# `vite build` also type-checks nothing by itself; run tsc explicitly so a type
# error fails the image build instead of shipping silently.
RUN npm run typecheck && npm run build

# --- Stage 2: Serve the static bundle ---
FROM nginx:1.27-alpine

# Reverse-proxies the API paths to the backend container and provides the SPA
# fallback. See the comments in nginx.conf — the /signup method split matters.
COPY nginx.conf /etc/nginx/conf.d/default.conf

COPY --from=builder /src/dist /usr/share/nginx/html

EXPOSE 80

# Inherits nginx's default CMD (`nginx -g 'daemon off;'`).
